<resources>
    <style name="Theme.Children" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>

    <style name="Theme.Children.Blocker" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="android:windowBackground">@color/blocker_bg</item>
        <item name="android:statusBarColor">@color/blocker_bg</item>
        <item name="android:navigationBarColor">@color/blocker_bg</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

    <!-- Baris daftar izin di langkah permission -->
    <style name="PermRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
