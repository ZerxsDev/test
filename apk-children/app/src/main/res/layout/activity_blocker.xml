<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blockerRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:background="@color/blocker_bg" android:padding="30dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔒" android:textSize="60sp"/>
    <TextView android:id="@+id/tvBlockTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Layar Dikunci Orang Tua" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="10dp"/>
    <TextView android:id="@+id/tvBlockSub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Masukkan password dari orang tua, atau minta orang tua membuka lewat web parental."
        android:textColor="#CCD6EA" android:gravity="center" android:textSize="14sp" android:layout_marginTop="8dp"/>

    <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="30dp" android:hint="Password orang tua" android:inputType="textPassword"
        android:background="#1D2639" android:padding="16dp" android:textColor="#FFFFFF" android:textColorHint="#7A89A8"
        android:gravity="center" android:textSize="18sp" android:importantForAutofill="no"/>

    <TextView android:id="@+id/tvWrong" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/red" android:gravity="center" android:visibility="invisible" android:layout_marginTop="8dp" android:text="Password salah!"/>

    <Button android:id="@+id/btnUnlock" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp"
        android:background="@drawable/btn_primary" android:text="Buka Kunci" android:textColor="#FFFFFF" android:textStyle="bold" android:textAllCaps="false" android:textSize="16sp"/>
</LinearLayout>
